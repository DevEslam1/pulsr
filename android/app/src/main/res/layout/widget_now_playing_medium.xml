<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background"
    android:gravity="center">

    <!-- Top Track Info & Artwork Row -->
    <LinearLayout
        android:id="@+id/widget_main_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Album Artwork -->
        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/launcher_icon"
            android:contentDescription="@string/widget_album_artwork" />

        <!-- Track Title, Artist & Album -->
        <LinearLayout
            android:id="@+id/widget_info_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:text="@string/widget_nothing_playing"
                android:textColor="#A3ABB8"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:text=""
                android:textColor="#94A0B3"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Favorite Button -->
        <ImageButton
            android:id="@+id/widget_favorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9.5dp"
            android:background="@drawable/widget_secondary_button_background"
            android:src="@drawable/ic_widget_heart"
            android:contentDescription="@string/widget_toggle_favorite" />
    </LinearLayout>

    <!-- Interactive Track Slider & High Precision Touch Zones -->
    <FrameLayout
        android:id="@+id/widget_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_gravity="center_vertical"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar" />

        <!-- 10 Granular Tap Zones (10% steps) for seek placement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/btn_seek_01" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/btn_seek_02" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/btn_seek_03" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/btn_seek_04" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/btn_seek_05" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/btn_seek_06" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/btn_seek_07" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/btn_seek_08" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/btn_seek_09" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
            <LinearLayout android:id="@+id/btn_seek_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:background="@android:color/transparent" android:contentDescription="@null" />
        </LinearLayout>
    </FrameLayout>

    <!-- Timestamps Row -->
    <LinearLayout
        android:id="@+id/widget_times_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/widget_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#A7B0C0"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="#A7B0C0"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Full Playback Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/widget_shuffle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:background="@drawable/widget_secondary_button_background"
            android:src="@drawable/ic_widget_shuffle"
            android:contentDescription="@string/widget_shuffle" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9.5dp"
            android:background="@drawable/widget_secondary_button_background"
            android:src="@drawable/ic_widget_skip_prev"
            android:contentDescription="@string/widget_previous" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/btn_rewind"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:background="@drawable/widget_secondary_button_background"
            android:src="@drawable/ic_widget_rewind"
            android:contentDescription="@string/widget_rewind_10s" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="14dp"
            android:background="@drawable/widget_play_button_background"
            android:src="@drawable/ic_widget_play"
            android:contentDescription="@string/widget_play_pause" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/btn_forward"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:background="@drawable/widget_secondary_button_background"
            android:src="@drawable/ic_widget_forward"
            android:contentDescription="@string/widget_forward_10s" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="9.5dp"
            android:background="@drawable/widget_secondary_button_background"
            android:src="@drawable/ic_widget_skip_next"
            android:contentDescription="@string/widget_next" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/widget_repeat"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:background="@drawable/widget_secondary_button_background"
            android:src="@drawable/ic_widget_repeat"
            android:contentDescription="@string/widget_repeat" />
    </LinearLayout>
</LinearLayout>
