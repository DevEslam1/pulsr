<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_play"
        android:enabled="true"
        android:icon="@drawable/ic_notification"
        android:shortcutShortLabel="@string/shortcut_play_short"
        android:shortcutLongLabel="@string/shortcut_play_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pulsr.music"
            android:targetClass="com.pulsr.music.MainActivity"
            android:data="pulsr://play" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_shuffle"
        android:enabled="true"
        android:icon="@drawable/ic_notification"
