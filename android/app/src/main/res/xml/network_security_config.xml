<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic ONLY to localhost / 127.0.0.1 for just_audio LockCachingAudioSource proxy -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!-- Internet radio (Icecast/Shoutcast) is often HTTP-only. Keep the
         system trust anchors for TLS and allow cleartext so user-added stream
         URLs actually play; all first-party APIs remain HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
