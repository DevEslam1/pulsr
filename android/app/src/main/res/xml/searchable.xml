<?xml version="1.0" encoding="utf-8"?>
<!--
  Searchable configuration for the assistant surface.
  The authority is flavor-specific (${applicationId}.suggestions) and supplied
  through a string resource. Suggestion taps are delivered as
  MEDIA_PLAY_FROM_SEARCH so the assistant intent service handles them like a
  spoken request. Suggestions are pushed only after the user opts in.
-->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/app_name"
    android:searchSuggestAuthority="@string/search_suggestions_authority"
    android:searchSuggestIntentAction="android.media.action.MEDIA_PLAY_FROM_SEARCH"
    android:searchSuggestSelection=" ?"
    android:searchSuggestThreshold="1"
    android:queryAfterZeroResults="false"
    android:includeInGlobalSearch="true" />
