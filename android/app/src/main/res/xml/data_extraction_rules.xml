<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="temp_art" />
        <exclude domain="file" path="app_instance_token" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="temp_art" />
        <exclude domain="file" path="app_instance_token" />
    </device-transfer>
</data-extraction-rules>
