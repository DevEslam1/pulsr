<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Pulsr Pure (prod): offline-only privacy build. Competes with Musicolet.
         INTERNET is stripped so no telemetry, ads, Firebase, Sentry, YTM or
         cloud sync can transmit even if Dart code paths remain. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />

    <application>
        <!-- YTM download worker must not exist in the offline build. -->
        <service
            android:name=".DownloadService"
            tools:node="remove" />
        <!-- Firebase / cloud components are Dart-gated by AppConfig.isPure;
             no extra native receivers are declared here by design. -->
    </application>
</manifest>
